DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
AddType text/plain .txt
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Cloudflare eseten a proxy HTTPS jelzeset is figyelembe vesszuk.
  RewriteCond %{HTTP_HOST} !^mitfozzekmost\.hu$ [NC]
  RewriteRule ^ https://mitfozzekmost.hu%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://mitfozzekmost.hu%{REQUEST_URI} [R=301,L,NE]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  # Letezo exportalt fajlok es mappak; nincs minden URL-t felfogo SPA fallback.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(html?|txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
